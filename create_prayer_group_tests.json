{
  "project": "prayer-api",
  "feature": "create_prayer_group_tests",
  "description": "Generate application-layer tests for Create Prayer Group service with discovery, verification, backup, and write validation.",
  "application": {
    "service": "internal/application/prayergroup/create.go",
    "test_output": "internal/application/prayergroup/create_test.go",
    "package": "prayergroup",
    "service_constructor": "NewCreateService",
    "execute_method": "Create",
    "command": "CreateCommand",
    "result": "CreateResult"
  },
  "expected": {
    "domain": {
      "directory": "internal/domain/prayergroup",
      "constructor": "New",
      "type_constant": "TypeRegular",
      "status_constant": "StatusActive"
    },
    "user_domain": {
      "directory": "internal/domain/user"
    },
    "role_domain": {
      "directory": "internal/domain/role",
      "permission": "PermissionManagePrayerGroups"
    },
    "repositories": {
      "users": "internal/repository/memory/user_repository.go",
      "roles": "internal/repository/memory/role_repository.go",
      "groups": "internal/repository/memory/prayer_group_repository.go",
      "ids": "internal/repository/memory/id_generator.go"
    }
  },
  "required_tests": [
    {
      "name": "TestAdministratorCanCreatePrayerGroup",
      "purpose": "Administrator successfully creates a prayer group."
    },
    {
      "name": "TestMemberCannotCreatePrayerGroup",
      "purpose": "Member without permission receives forbidden."
    },
    {
      "name": "TestUnknownActorCannotCreatePrayerGroup",
      "purpose": "Unknown user receives actor not found."
    },
    {
      "name": "TestPrayerGroupNameRequired",
      "purpose": "Empty name is rejected."
    },
    {
      "name": "TestPrayerGroupDescriptionIsPersisted",
      "purpose": "Description is stored on the created group."
    },
    {
      "name": "TestPrayerGroupDefaultsToRegularType",
      "purpose": "Created prayer group uses TypeRegular."
    },
    {
      "name": "TestPrayerGroupDefaultsToActiveStatus",
      "purpose": "Created prayer group is active."
    },
    {
      "name": "TestPrayerGroupReceivesGeneratedID",
      "purpose": "Generated ID from ID generator is assigned."
    },
    {
      "name": "TestPrayerGroupIsSaved",
      "purpose": "Repository Save() persists the created prayer group."
    }
  ],
  "verification": {
    "before_write": [
      "Go project exists",
      "Application service exists",
      "Create service discovered",
      "Create method discovered",
      "PrayerGroup constructor discovered",
      "PermissionManagePrayerGroups exists",
      "Memory repositories exist",
      "ID generator supports prayer groups"
    ],
    "after_write": [
      "Test file written",
      "All required test names exist",
      "Imports verified",
      "Package verified",
      "Service constructor usage verified",
      "Create command usage verified",
      "Permission assertion verified",
      "Repository save assertion verified",
      "Status assertion verified",
      "Type assertion verified",
      "Generated ID assertion verified"
    ]
  },
  "backup": {
    "enabled": true,
    "folder": ".generator-backups"
  },
  "logging": {
    "info": "[INFO]",
    "ok": "[ OK ]",
    "fail": "[FAIL]"
  }
}